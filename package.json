{
  "name": "@tolokacode/checkbox",
  "version": "0.1.1",
  "description": "TypeScript SDK for the Checkbox API (ПРРО, fiscal receipts in Ukraine)",
  "license": "MIT",
  "author": "tolokacode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolokacode/checkbox-js.git"
  },
  "homepage": "https://github.com/tolokacode/checkbox-js#readme",
  "bugs": {
    "url": "https://github.com/tolokacode/checkbox-js/issues"
  },
  "keywords": [
    "checkbox",
    "prro",
    "ukraine",
    "fiscal",
    "receipts"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p test",
    "generate": "openapi-typescript https://api.checkbox.in.ua/api/openapi.json --default-non-nullable=false -o src/schema.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "version": "node -e \"const fs=require('fs');fs.writeFileSync('src/index.ts',fs.readFileSync('src/index.ts','utf8').replace(/VERSION = '[^']+'/,'VERSION = \\''+require('./package.json').version+'\\''))\" && git add src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
